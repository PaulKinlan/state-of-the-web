# Large binary files (screenshots, HARs, traces, heap snapshots)
# JSON evidence IS tracked (axe results, layout metrics, probes, etc.)
*.png
*.har
*.trace
*.warc.gz
*.heapsnapshot
*.mp4
# Raw Chrome traces are huge (60-136MB each); track trace-summary.json instead
trace.json

# Raw CDP discoverability screenshots (large, from my runner)
www_*-discoverability-*.png

# Temporary batch files
results-gpt/batch-*.partial.json
results-gpt/batch-*.log
results-gpt/*.pid
results/*.partial.json

# Python
__pycache__/
*.pyc

# SQLite DB (regenerated from JSON)
*.db
*.heapsnapshot
results/gpt/memory-batch-*-evidence/
*.mp4

# Local atomic run workspace. The reconciler publishes the exact manifest,
# metadata, inventory, and canonical report JSON under results/atomic/ instead.
runs/*/atomic-reports/
runs/*/*.log
runs/*/*.csv.gz
runs/*/atomic-retry-status.json
runs/*/atomic-retry-urls.txt
runs/*/atomic-urls.txt
runs/*/manifest.csv
runs/*/manifest.sha256
runs/*/run.json
